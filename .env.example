# Absolute paths to your course folders. JSON array syntax (pydantic-settings requirement).
# Optionally add a personal notes folder (e.g. inside your Obsidian vault) --
# anything written there is picked up automatically, no "Sync now" needed.
COURSE_ROOTS=["C:\\Users\\vous\\Documents\\Cours\\4A","C:\\Users\\vous\\Documents\\Cours\\5A"]

# Where the single SQLite file (relational data + vectors) is stored.
DB_PATH=data/study_copilot.db

# Obsidian vault root: subject fiches are auto-exported here as markdown
# (under "Cours CPE/") after every sync/generation. Leave empty to disable.
OBSIDIAN_VAULT_PATH=

WATCH_DEBOUNCE_SECONDS=8

# Which LLM backend to use for Q&A / quiz generation / summaries:
#   ollama    -> local, free, runs on this machine (needs https://ollama.com installed + a model pulled)
#   anthropic -> Claude API, paid per token, better answer quality
LLM_PROVIDER=ollama

# Only used when LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Only used when LLM_PROVIDER=anthropic. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-5
LLM_FAST_MODEL=claude-haiku-4-5

# Local multilingual embedding model (sentence-transformers), no API key needed.
EMBEDDING_MODEL=intfloat/multilingual-e5-base
EMBEDDING_DIM=768

RETRIEVAL_TOP_K=10

CORS_ORIGINS=["http://localhost:5173"]
